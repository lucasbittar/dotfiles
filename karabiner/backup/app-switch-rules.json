{
  "title": "App switching via shell_command (backup, replaced by Hammerspoon)",
  "rules": [
    {
      "description": "Switch to Ghostty (Control + 1)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "1",
            "modifiers": {
              "mandatory": ["control"]
            }
          },
          "to": [
            {
              "shell_command": "open -a Ghostty"
            }
          ]
        }
      ]
    },
    {
      "description": "Switch to Google Chrome (Control + 2)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "2",
            "modifiers": {
              "mandatory": ["control"]
            }
          },
          "to": [
            {
              "shell_command": "open -a 'Google Chrome'"
            }
          ]
        }
      ]
    },
    {
      "description": "Switch to Slack (Control + 3)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "3",
            "modifiers": {
              "mandatory": ["control"]
            }
          },
          "to": [
            {
              "shell_command": "open -a Slack"
            }
          ]
        }
      ]
    },
    {
      "description": "Switch to Notion (Control + 4)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "4",
            "modifiers": {
              "mandatory": ["control"]
            }
          },
          "to": [
            {
              "shell_command": "open -a Notion"
            }
          ]
        }
      ]
    }
  ]
}
