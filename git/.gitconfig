[user]

	name = Lucas Bittar Magnani
	email = lucasbittar.magnani@gmail.com

[color "branch"]

    current = green bold
    local = green
    remote = yellow

[color "diff"]

    frag = magenta
    meta = yellow
    new = green
    old = red

[color "status"]

    added = green
    changed = yellow
    untracked = red

[push]

    default = simple

[core]

    abbrev = 12
    attributesfile = ~/.gitattributes
    autocrlf = input
    editor = vim
    excludesfile = ~/.gitignore
    pager = delta

[interactive]

    # Syntax highlighting in `git add -p` too
    diffFilter = delta --color-only

[delta]

    navigate = true           # n / N jump between files
    line-numbers = true
    syntax-theme = Monokai Extended
    # Same backgrounds as Neovim's diffs (colors/benokai.lua)
    plus-style = syntax "#26331a"
    plus-emph-style = syntax "#3f5a24"
    minus-style = syntax "#3a1c24"
    minus-emph-style = syntax "#6b2836"

[alias]
    in = !(git fetch --quiet && git log --pretty=format:'%C(yellow)%h %C(white)- %C(red)%an %C(white)- %C(cyan)%d%Creset %s %C(white)- %ar%Creset' ..@{u})
    out = !(git fetch --quiet && git log --pretty=format:'%C(yellow)%h %C(white)- %C(red)%an %C(white)- %C(cyan)%d%Creset %s %C(white)- %ar%Creset' @{u}..)

[diff "bin"]

    # Use `hexdump` to diff binary files

    textconv = hexdump -v -C

[pretty]

    custom = "%C(magenta)%h%C(red)%d %C(yellow)%ar %C(green)%s %C(yellow)(%an)"
    #                     │        │            │            │             └─ author name
    #                     │        │            │            └─ message
    #                     │        │            └─ date (relative)
    #                     │        └─ decorations (branch, heads or tags)
    #                     └─ hash (abbreviated)

[user]

    # Don't guess the user's identity
    # https://github.com/git/git/blob/90f7b16b3adc78d4bbabbd426fb69aa78c714f71/Documentation/config.txt#L2847-L2855

    useConfigOnly = true
[merge]

	tool = kdiff3

[diff]

	tool = kdiff3
[pull]
	rebase = false

[branch]
    autoSetupRemove = true
[init]
	defaultBranch = main
